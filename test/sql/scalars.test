# name: test/sql/scalars.test
# group: [vgi_jolt]
#
# Scalars: jolt_transform, jolt_shift, jolt_default, is_valid_jolt_spec, json_valid.

require-env VGI_JOLT_WORKER

statement ok
LOAD vgi;

# haybarn does not autoload the json extension; load it explicitly so
# json_extract / json_extract_string are available for semantic assertions.
statement ok
LOAD json;

statement ok
ATTACH 'jolt' AS jolt (TYPE vgi, LOCATION '{VGI_JOLT_WORKER}');

# ---- jolt_transform: full shift chainr remaps a nested value ----------------

# Assert on the extracted field (not raw string) since Jolt key order may vary.
query I
SELECT json_extract(
  jolt.jolt_transform(
    '{"rating":{"primary":{"value":3}}}',
    '[{"operation":"shift","spec":{"rating":{"primary":{"value":"Rating"}}}}]'),
  '$.Rating');
----
3

# ---- jolt_transform: shift + default + remove chainr ------------------------

query II
SELECT
  json_extract(t, '$.Rating'),
  json_extract(t, '$.Reviewed')
FROM (
  SELECT jolt.jolt_transform(
    '{"rating":{"primary":{"value":4}},"id":"abc"}',
    '[{"operation":"shift","spec":{"rating":{"primary":{"value":"Rating"}},"id":"ProductId"}},'
    '{"operation":"default","spec":{"Reviewed":true}},'
    '{"operation":"remove","spec":{"ProductId":""}}]') AS t
);
----
4	true

# The removed key is gone.
query I
SELECT json_extract(
  jolt.jolt_transform(
    '{"rating":{"primary":{"value":4}},"id":"abc"}',
    '[{"operation":"shift","spec":{"rating":{"primary":{"value":"Rating"}},"id":"ProductId"}},'
    '{"operation":"remove","spec":{"ProductId":""}}]'),
  '$.ProductId') IS NULL;
----
true

# ---- jolt_shift convenience -------------------------------------------------

query I
SELECT json_extract(
  jolt.jolt_shift(
    '{"rating":{"primary":{"value":3}}}',
    '{"rating":{"primary":{"value":"Rating"}}}'),
  '$.Rating');
----
3

# ---- jolt_default convenience -----------------------------------------------

query I
SELECT json_extract_string(
  jolt.jolt_default('{"name":"widget"}', '{"inStock":true}'),
  '$.name');
----
widget

query I
SELECT json_extract(
  jolt.jolt_default('{"name":"widget"}', '{"inStock":true}'),
  '$.inStock');
----
true

# ---- NULL input -> NULL -----------------------------------------------------

query I
SELECT jolt.jolt_transform(
  NULL,
  '[{"operation":"shift","spec":{"a":"b"}}]') IS NULL;
----
true

# ---- is_valid_jolt_spec -----------------------------------------------------

query I
SELECT jolt.is_valid_jolt_spec('[{"operation":"shift","spec":{"a":"b"}}]');
----
true

query I
SELECT jolt.is_valid_jolt_spec('[{"operation":"no-such-op","spec":{}}]');
----
false

query I
SELECT jolt.is_valid_jolt_spec('not json at all');
----
false

# ---- json_valid -------------------------------------------------------------

query I
SELECT jolt.json_valid('{"a":1}');
----
true

query I
SELECT jolt.json_valid('{not valid');
----
false

# NULL -> NULL.
query I
SELECT jolt.json_valid(NULL) IS NULL;
----
true

# ---- malformed spec / input raise a clear error -----------------------------

statement error
SELECT jolt.jolt_transform('{"a":1}', '{not a valid spec');
----

statement error
SELECT jolt.jolt_transform('{not json', '[{"operation":"shift","spec":{"a":"b"}}]');
----

# ---- composed pipelines (ComposedExamples.java + the agent-task grader) ------

# json_valid guards jolt_shift: the truncated row 2 is filtered out, not fatal.
query ITR
SELECT raw.id, json_extract_string(normalized, '$.device'), CAST(json_extract_string(normalized, '$.celsius') AS DOUBLE)
FROM (SELECT raw.id, jolt.main.jolt_shift(raw.payload, '{"dev":"device","reading":{"c":"celsius"}}') AS normalized, raw.payload
FROM (VALUES (1, '{"dev":"t-1","reading":{"c":21.5}}'), (2, '{"dev":"t-2","reading":'), (3, '{"dev":"t-3","reading":{"c":19.0}}')) AS raw(id, payload)
WHERE jolt.main.json_valid(raw.payload)) AS raw ORDER BY raw.id;
----
1	t-1	21.5
3	t-3	19.0

# jolt_shift -> jolt_default -> aggregate (also the README "Composing" example).
query TIR
WITH orders(payload) AS (VALUES ('{"order":{"id":101,"total":{"amount":25.0,"currency":"EUR"}}}'), ('{"order":{"id":102,"total":{"amount":40.0}}}'), ('{"order":{"id":103,"total":{"amount":15.5,"currency":"EUR"}}}'), ('{"order":{"id":104,"total":{"amount":9.5}}}')),
canonical AS (SELECT jolt.main.jolt_default(jolt.main.jolt_shift(orders.payload, '{"order":{"id":"order_id","total":{"amount":"amount","currency":"currency"}}}'), '{"currency":"USD"}') AS doc FROM orders)
SELECT json_extract_string(canonical.doc, '$.currency') AS currency, count(*) AS order_count, sum(CAST(json_extract_string(canonical.doc, '$.amount') AS DOUBLE)) AS revenue
FROM canonical GROUP BY currency ORDER BY currency;
----
EUR	2	40.5
USD	2	49.5

# json_valid + is_valid_jolt_spec preflight of a mapping registry.
query TTT
SELECT m.mapping, jolt.main.json_valid(m.sample_doc), jolt.main.is_valid_jolt_spec(m.spec)
FROM (VALUES ('orders_v1', '{"order":{"id":1}}', '[{"operation":"shift","spec":{"order":{"id":"order_id"}}}]'), ('orders_v2', '{"order":{"id":2}}', '[{"operation":"shfit","spec":{"order":{"id":"order_id"}}}]'), ('sensors_v1', '{"dev":"t-1",}', '[{"operation":"default","spec":{"unit":"C"}}]')) AS m(mapping, sample_doc, spec)
ORDER BY m.mapping;
----
orders_v1	true	true
orders_v2	true	false
sensors_v1	false	true

# validate_reshape_default_tiers grader: nested default fills user.tier.
query TT
SELECT json_extract_string(doc, '$.user.id') AS user_id, json_extract_string(doc, '$.user.tier') AS tier FROM (SELECT jolt.main.jolt_default(jolt.main.jolt_shift(t.p, '{"usr":"user.id","plan":"user.tier"}'), '{"user":{"tier":"free"}}') AS doc FROM (VALUES ('{"usr":"a1","plan":"pro"}'), ('{"usr":"b2"}'), ('{"usr":"c3"'), ('{"usr":"d4","plan":"team"}'), ('{"usr":"e5"}')) AS t(p) WHERE jolt.main.json_valid(t.p)) ORDER BY user_id;
----
a1	pro
b2	free
d4	team
e5	free

statement ok
DETACH jolt;
